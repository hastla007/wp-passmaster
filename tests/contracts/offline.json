        "payload": "string",
        "signature": "string",
        "kind": "string",
        "cursor": "string",
        "count": "int",
        "expires_at": "string"
      }
    },
    "package payload": {
      "direction": "inbound",
      "request": {},
      "response": {
        "format": "string",
        "v": "int",
        "kind": "string",
        "site": "string",
        "device_id": "string",
        "key_id": "string",
        "event": {
          "id": "int",
          "name": "string"
        },
        "occurrence": {
          "id": "int",
          "starts_at": "string",
          "ends_at": "string|null",
          "timezone": "string",
          "status": "string",
          "doors_open_at": "string|null"
        },
        "issued_at": "string",
        "expires_at": "string",
        "since": "string|null",
        "cursor": "string",
        "rules": {
          "max_offline_hours": "int",
          "duplicate_policy": "string",
          "attendee_names": "bool"
        },
        "device_area_id": "int|null",
        "hash": "string",
        "ticket_types": [
          {
            "id": "int",
            "name": "string",
            "areas": [],
            "policy": "string",
            "multi": "bool",
            "id_check": "bool",
            "min_age": "int",
            "hint": "string"
          }
        ],
        "areas": [],
        "tickets": [
          {
            "h": "string",
            "s": "string",
            "t": "int",
            "?n": "string"
          }
        ]
      }
    }
  }
