{
  "contract": "offline",
  "version": "1.0",
  "description": "Offline-Scanner pass-captain/v1/app/offline/… (Geräte-Bearer-Token). Requests sind Parameter mit Platzhaltern, Responses Shapes; \"package payload\" ist die signierte Paket-JSON im Feld payload.",
  "endpoints": {
    "GET /app/offline/keys": {
      "direction": "inbound",
      "request": {},
      "response": {
        "keys": [
          {
            "key_id": "string",
            "alg": "string",
            "public_key": "string",
            "status": "string",
            "created_at": "string",
            "valid_until": "string|null"
          }
        ],
        "server_time": "string"
      }
    },
    "GET /app/offline/occurrences": {
      "direction": "inbound",
      "request": {},
      "response": {
        "occurrences": [
          {
            "occurrence_id": "int",
            "event_id": "int",
            "event": "string",
            "starts_at": "string",
            "ends_at": "string|null",
            "timezone": "string",
            "status": "string",
            "rules": {
              "max_offline_hours": "int",
              "duplicate_policy": "string",
              "attendee_names": "bool"
            }
          }
        ],
        "device_id": "string",
        "server_time": "string"
      }
    },
    "GET /app/offline/package": {
      "direction": "inbound",
      "request": {
