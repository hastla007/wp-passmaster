msgstr "Bonifico: IBAN"

#: src/Admin/SettingsPage.php:132
msgid "Wird nach der Bestellung und in der Bestell-E-Mail mit Betrag, Verwendungszweck und Zahlungsfrist angezeigt."
msgstr "Viene mostrato dopo l'ordine e nell'e-mail dell'ordine con importo, causale e termine di pagamento."

#: src/Admin/SettingsPage.php:133
msgid "Überweisung: BIC"
msgstr "Bonifico: BIC"

#: src/Admin/SettingsPage.php:134
msgid "Reservierung bei manueller Zahlung (Stunden)"
msgstr "Prenotazione con pagamento manuale (ore)"

#: src/Admin/SettingsPage.php:134
msgid "Endet spätestens mit Beginn des (ersten) Termins."
msgstr "Termina al più tardi all'inizio della (prima) data."

#: src/Admin/SettingsPage.php:135
