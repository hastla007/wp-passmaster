#: src/Admin/SettingsPage.php:153
msgid "Währung für neue Ticketarten, Kassen, Rabattcodes und SMS-Kosten (ISO-Code, z. B. EUR oder CHF). Bestehende Preise behalten ihre Währung."
msgstr "Valuta per nuovi tipi di biglietto, casse, codici sconto e costi SMS (codice ISO, ad es. EUR o CHF). I prezzi esistenti mantengono la loro valuta."

#: src/Admin/SettingsPage.php:155
msgid "Angebotene Währungen"
msgstr "Valute offerte"

#: src/Admin/SettingsPage.php:155
msgid "ISO-Codes, durch Komma getrennt, z. B. „CHF, EUR“. Leer = EUR, USD, CHF, GBP, CAD, AUD. Ein Filter (wp_pass_captain_currencies_v1) hat Vorrang."
msgstr "Codici ISO separati da virgola, ad es. «CHF, EUR». Vuoto = EUR, USD, CHF, GBP, CAD, AUD. Un filtro (wp_pass_captain_currencies_v1) ha la precedenza."

#. translators: %s: field label
#: src/SettingsSchema.php:321
#, php-format
msgid "„%s“ muss ein Währungscode aus drei Buchstaben sein (z. B. EUR)."
msgstr "«%s» deve essere un codice valuta di tre lettere (ad es. EUR)."

