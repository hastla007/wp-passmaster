#. translators: %s: comma separated setting names
#: src/Security/Vault.php:277
#, php-format
msgid "Gespeicherte Zugangsdaten können nicht mehr entschlüsselt werden (Schlüssel PASS_CAPTAIN_SECRET_KEY oder die wp-config-Salts wurden geändert): %s. Sie werden als „nicht gesetzt“ behandelt – bitte erneut eingeben."
msgstr "Le credenziali salvate non possono più essere decifrate (la chiave PASS_CAPTAIN_SECRET_KEY o i salt di wp-config sono stati modificati): %s. Vengono trattate come «non impostate»: inseriscile di nuovo."

#: src/Security/Vault.php:281
msgid "Pass Captain: libsodium oder ein Schlüssel fehlt – Zugangsdaten werden unverschlüsselt gespeichert."
msgstr "Pass Captain: manca libsodium o una chiave; le credenziali vengono salvate senza cifratura."

#: src/Security/Vault.php:290
msgid "Zugangsdaten werden mit PASS_CAPTAIN_SECRET_KEY verschlüsselt gespeichert."
msgstr "Le credenziali vengono salvate cifrate con PASS_CAPTAIN_SECRET_KEY."

#: src/Security/Vault.php:292
msgid "Zugangsdaten werden mit einem aus den wp-config-Salts (AUTH_KEY, SECURE_AUTH_KEY) abgeleiteten Schlüssel verschlüsselt. Werden die Salts erneuert, müssen alle Zugangsdaten neu eingegeben werden. Empfohlen: eigene Konstante PASS_CAPTAIN_SECRET_KEY (32 zufällige Bytes, hex) in wp-config.php."
msgstr "Le credenziali vengono cifrate con una chiave derivata dai salt di wp-config (AUTH_KEY, SECURE_AUTH_KEY). Se i salt vengono rinnovati, tutte le credenziali devono essere inserite di nuovo. Consigliato: una costante dedicata PASS_CAPTAIN_SECRET_KEY (32 byte casuali, hex) in wp-config.php."

#: src/Security/Vault.php:294
msgid "Kein Schlüssel verfügbar: Zugangsdaten werden unverschlüsselt gespeichert."
msgstr "Nessuna chiave disponibile: le credenziali vengono salvate senza cifratura."

