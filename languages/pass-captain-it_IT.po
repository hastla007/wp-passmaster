msgstr "Le tue impostazioni corrispondono già a questo profilo."

#: src/Admin/SettingsTools.php:303
msgid "Vorschlag"
msgstr "Proposta"

#: src/Admin/SettingsTools.php:309
msgid "Ausgewählte Werte übernehmen"
