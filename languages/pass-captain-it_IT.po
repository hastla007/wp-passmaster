msgid "Gilt für Event- und Termin-Wartelisten. 0 = nie."
msgstr "Vale per le liste d’attesa di eventi e appuntamenti. 0 = mai."

#: src/Admin/SettingsPage.php:444
msgid "Mitgliedspässe nach Ablauf der Gültigkeit anonymisieren nach (Tagen)"
msgstr "Anonimizza le tessere socio dopo la scadenza dopo (giorni)"

